            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Complete Node.js REST API Assignment\",\n  \"description\": \"Build authentication, CRUD operations, Zod validation, and security best practices\",\n  \"priority\": \"high\",\n  \"status\": \"in-progress\",\n  \"dueDate\": \"2026-11-01T18:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Creates a new task associated with the authenticated user and stores taskId in collection variables"
          }
