    {
      "name": "Tasks (CRUD)",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data) {",
                  "    const id = response.data.id || response.data._id;",
                  "    if (id) {",
                  "        pm.collectionVariables.set('taskId', id);",
                  "        console.log('Saved taskId to collection variables:', id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
