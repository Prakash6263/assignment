# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Replace with your actual MongoDB URI or local instance)
# Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/assignment?retryWrites=true&w=majority
# Local MongoDB: mongodb://localhost:27017/assignment
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/assignment?retryWrites=true&w=majority
DB_NAME=assignment

# JWT Access Token Configuration (Short-lived)
JWT_SECRET=replace_with_a_strong_random_secret_string_minimum_32_characters
JWT_EXPIRES_IN=15m

# JWT Refresh Token Configuration (Long-lived)
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret_string_for_refresh
JWT_REFRESH_EXPIRES_IN=7d
